{
  "manifest_version": 3,
  "name": "TokeNitrate",
  "version": "0.0.0",
  "description": "Estimates ChatGPT token usage and helps reduce unnecessary prompt tokens.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
